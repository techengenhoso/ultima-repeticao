# Somente servidor: copie para .env.local e preencha sem versionar segredos
# A montagem automática funciona no navegador e não usa chave de IA

# Deve corresponder ao projeto usado pelo Firebase Auth do aplicativo
FIREBASE_ADMIN_PROJECT_ID=ultima-repeticao-5da2b
# Preencha o par abaixo OU utilize Application Default Credentials
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Alternativa local para ADC: caminho absoluto para a credencial, fora do repositório
# GOOGLE_APPLICATION_CREDENTIALS=
