{
  "files.associations": {
    "*.css": "tailwindcss"
  },

  "editor.defaultFormatter": "biomejs.biome",

  "editor.codeActionsOnSave": {
    "source.action.useSortedKeys.biome": "explicit",
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },

  "cSpell.words": [
    "esnext",
    "firebaseapp",
    "firebasestorage",
    "firestore",
    "indentação",
    "repeticao",
    "shadcn",
    "tailwindcss"
  ]
}
