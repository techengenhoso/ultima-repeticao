{
  "files.associations": {
    "*.css": "tailwindcss"
  },

  "editor.defaultFormatter": "biomejs.biome",

  "editor.codeActionsOnSave": {
    "source.action.useSortedKeys.biome": "explicit",
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },

  "cSpell.words": [
    "abdominis",
    "anconeus",
    "brachialis",
    "brachioradialis",
    "braquiorradial",
    "esnext",
    "firebaseapp",
    "firebasestorage",
    "firestore",
    "indentação",
    "infraespinal",
    "infraspinatus",
    "latae",
    "lumborum",
    "multifidus",
    "pectineus",
    "radialis",
    "repeticao",
    "shadcn",
    "supraespinal",
    "supraspinatus",
    "tailwindcss"
  ]
}
