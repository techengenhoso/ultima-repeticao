rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;

      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      match /workoutSessions/{sessionId} {
        allow read: if isOwner();
        allow write: if false;
      }

      match /bodyAssessments/{assessmentId} {
        allow read, write: if false;
      }

      function validExerciseContent(data) {
        return data.name is string && data.name.size() >= 3 && data.name.size() <= 100
          && data.muscleGroup in [
            'adductors', 'forearms', 'biceps', 'core', 'fullBody', 'back',
            'glutes', 'lowerBack', 'shoulders', 'calves', 'chest',
            'hamstrings', 'quadriceps', 'triceps'
          ]
          && data.primaryMuscles is list
          && data.primaryMuscles.size() >= 1 && data.primaryMuscles.size() <= 20
          && data.secondaryMuscles is list && data.secondaryMuscles.size() <= 20
          && data.difficulty in ['easy', 'moderate', 'hard']
          && data.movementPattern is string
          && data.movementPattern.size() <= 150
          && data.startingPosition is string
          && data.startingPosition.size() <= 1000
          && data.movementExecution is string
          && data.movementExecution.size() <= 1000
          && data.importantCautions is string
          && data.importantCautions.size() <= 1000;
      }

      match /exercises/{exerciseId} {
        function validExercise(data) {
          return data.keys().hasOnly([
              'name', 'normalizedName', 'muscleGroup', 'primaryMuscles',
              'secondaryMuscles', 'difficulty',
              'movementPattern', 'startingPosition', 'movementExecution',
              'importantCautions'
            ])
            && data.normalizedName is string && data.normalizedName.size() >= 3
            && validExerciseContent(data);
        }

        allow read, delete: if isOwner();
        allow create: if isOwner() && validExercise(request.resource.data);
        allow update: if isOwner() && validExercise(request.resource.data);
      }

      match /exerciseOverrides/{exerciseId} {
        function validOverride(data) {
          return data.keys().hasOnly([
              'name', 'muscleGroup', 'primaryMuscles', 'secondaryMuscles',
              'difficulty', 'movementPattern',
              'startingPosition', 'movementExecution', 'importantCautions'
            ])
            && validExerciseContent(data);
        }

        allow read, delete: if isOwner();
        allow create: if isOwner() && validOverride(request.resource.data);
        allow update: if isOwner() && validOverride(request.resource.data);
      }

      match /workoutPlans/{workoutPlanId} {
        function validPlan(data) {
          return data.keys().hasOnly([
              'name', 'description', 'isActive', 'days', 'createdAt', 'updatedAt'
            ])
            && data.name is string && data.name.size() >= 3 && data.name.size() <= 100
            && (data.description == null
              || (data.description is string && data.description.size() <= 500))
            && data.isActive is bool
            && data.days is list && data.days.size() >= 1 && data.days.size() <= 14
            && data.createdAt is timestamp && data.updatedAt is timestamp;
        }

        allow read, delete: if isOwner();
        allow create: if isOwner()
          && validPlan(request.resource.data)
          && request.resource.data.isActive == false
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner()
          && validPlan(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }
  }
}
